### Xcode ###
# User-specific files (IGNORE)
**/xcuserdata/*
*.xcuserstate
*.xcuserdata

# Xcode workspace (CAUTION: Don't ignore the entire workspace!)
*.xcodeproj/project.xcworkspace/xcuserdata/

# DerivedData (build artifacts)
DerivedData/

# Build products
*.o
*.a
*.d
*.pch
*.bak
*.tmp
*.swp

# Swift Package Manager (CAUTION: Keep Package.resolved!)
.build/
/Packages/
/.swiftpm/

# CocoaPods
Pods/
Podfile.lock

# Carthage
Carthage/Build

### macOS ###
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# AFP/networking artifacts
.NetworkTrash/
.AppleDB/
.AppleDesktop/
Network Trash Folder/
Temporary Items/
.apdisk

### Fastlane ###
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

### SwiftLint ###
swiftlint_report.html
